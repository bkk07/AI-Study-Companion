# AI Study Companion — Frontend environment template
# Copy to `frontend/.env` and fill with real values. Never commit `.env`.

# Browser → FastAPI base URL (host-resolvable, not a Docker service name)
# In Docker Compose the browser talks to localhost:8000;
# inside containers the backend/worker talk to postgres/redis via service names.
VITE_API_BASE_URL=http://localhost:8000
VITE_API_V1_PREFIX=/api/v1
