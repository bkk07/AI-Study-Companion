# AI Study Companion — Backend environment template
# Copy to `backend/.env` and fill with real values. Never commit `.env`.
# All values below are placeholders — no real secrets.
#
# IMPORTANT: docker-compose.yml injects config via `environment:`, which
# OVERRIDES backend/.env inside containers. So after filling GROQ_API_KEY /
# INCEPTION_API_KEY (or any key), export them in the SAME shell, e.g.:
#   PowerShell: $g = (Select-String backend/.env -Pattern "^GROQ_API_KEY=").Line -replace "^GROQ_API_KEY=",""
#               $i = (Select-String backend/.env -Pattern "^INCEPTION_API_KEY=").Line -replace "^INCEPTION_API_KEY=",""
#               $env:GROQ_API_KEY = $g.Trim(); $env:INCEPTION_API_KEY = $i.Trim()
#               $env:LLM_PROVIDER = "inception"; docker compose up -d
# Without this, containers fall back to dummy keys and AI calls fail.

# Database — PostgreSQL (SQLAlchemy, psycopg3 driver — scheme must be postgresql+psycopg://)
# Docker Compose service name `postgres` is used inside containers;
# host-local dev uses localhost. Example values:
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_study_companion
# For host-local runs: postgresql+psycopg://postgres:postgres@localhost:5432/ai_study_companion
# For Neon (dev or prod, via environment only — never commit real credentials):
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require

# Authentication
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=2880

# AI providers — LLM_PROVIDER selects the chat backend ("groq" or "inception").
# Mercury 2.5 (Inception) only accepts temperature 0.5-1; the client clamps
# our temp-0 default up to 0.5 automatically, no action needed.
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
INCEPTION_API_KEY=your-inception-api-key-here
INCEPTION_MODEL=mercury-2.5
# Embeddings default to local fastembed (BAAI/bge-small-en-v1.5, 384 dims, no key).
# Set EMBEDDING_PROVIDER=openai + OPENAI_API_KEY to use text-embedding-3-small (1536 dims,
# requires resizing the embeddings column back — local and OpenAI dims cannot mix).
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small

# Hybrid PDF pipeline — per-page Tesseract OCR for scanned pages (worker only).
# DPI 300 is Tesseract's sweet spot; LANGUAGE accepts codes like "eng+deu".
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300

# Background processing — Redis via environment (same instance for API + worker).
# Demo single-container default (bundled loopback Redis inside the demo image):
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# For docker-compose dev (shared `redis` service): redis://redis:6379/0
# For host-local runs: redis://localhost:6379/0
# For managed Redis (via environment only — never commit real credentials):
# REDIS_URL=redis://<host>:<port>/0
# CELERY_BROKER_URL=redis://<host>:<port>/0
# CELERY_RESULT_BACKEND=redis://<host>:<port>/0
# If the provider requires TLS, use the rediss:// scheme instead:
# REDIS_URL=rediss://<host>:<port>/0
# (Set the same URL for all three vars so API and worker share one instance.)

# File storage — shared Docker volume mount, must be identical in api + worker
UPLOAD_DIR=/data/uploads

# App
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
LOG_LEVEL=info
# Comma-separated allow-list — never "*". Production must list the real frontend origin(s).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# AI-cost protection (Phase 49): per-minute LLM budgets, enforced per user and per project.
RATE_LIMIT_LLM_PER_MINUTE_USER=30
RATE_LIMIT_LLM_PER_MINUTE_PROJECT=120
RATE_LIMIT_WINDOW_SECONDS=60

# Admin (seeded via env, not hardcoded)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
